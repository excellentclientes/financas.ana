rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados compartilhados: somente os e-mails autorizados, com e-mail verificado.
    match /dados/{espaco}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['acfranco1974@gmail.com', 'excellentservices.excel@gmail.com'];
    }
    // Leitura dos dados antigos da própria conta (usada só para migração).
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['acfranco1974@gmail.com', 'excellentservices.excel@gmail.com'];
    }
  }
}
